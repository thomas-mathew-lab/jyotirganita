    family-names: Mathew
    orcid: "https://orcid.org/0000-0002-5289-4056"
    affiliation: "Department of Physics, St. Stephen's College, Uzhavoor, Kottayam, Kerala, India"
    email: mathew.physics@gmail.com
version: 0.0.1
license: Apache-2.0
repository-code: "https://github.com/thomas-mathew-lab/jyotirganita"
url: "https://github.com/thomas-mathew-lab/jyotirganita"
keywords:
  - pañcāṅgam
  - Indian calendar
  - siddhantic astronomy
  - computational astronomy
